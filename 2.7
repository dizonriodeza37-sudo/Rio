package helloworld.variable;

public class DemoVariables4 {

    public static void main(String[] args) {

        char myGrade = 'A';
        char myFriendsGrade = 'C';

        System.out.println("My grade is " + myGrade);
        System.out.println("My friend's grade is " + myFriendsGrade);
        System.out.println("Our grades are " + myGrade + " and " + myFriendsGrade);
    }
}